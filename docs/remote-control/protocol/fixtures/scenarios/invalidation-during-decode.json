        "attachment_id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
      }
    },
    {
      "send": "relay_to_staff",
      "message": {
        "v": 1,
        "type": "support_pending",
        "id": null,
        "device_id": "0f1e2d3c4b5a69788796a5b4c3d2e1f0",
        "attachment_id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
      }
    },
    {
      "local": "tablet",
      "event": "person taps Allow; grant deadline = elapsedRealtime() + GRANT_MAX_S"
