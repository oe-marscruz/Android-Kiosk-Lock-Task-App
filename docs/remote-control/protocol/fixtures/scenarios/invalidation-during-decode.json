        "reason": "geometry_changed"
      }
    },
    {
      "local": "desktop",
      "event": "Tk: invalidation clears the displayed reference, keeps input disabled"
    },
    {
      "local": "desktop",
      "event": "decode of frame 42 completes; Tk step 3 finds the grant no longer live"
    },
    {
      "absent": "staff_to_relay",
      "type": "frame_displayed",
      "why": "decoded frame is discarded, never committed"
